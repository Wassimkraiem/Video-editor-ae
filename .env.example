# Copy to .env (git-ignored). The API and worker read it; never commit keys.

# Claude Agent SDK (used by the worker / in-process local worker).
# A Console API key (sk-ant-api03-...) from https://console.anthropic.com,
ANTHROPIC_API_KEY=
# or instead a Claude subscription token from `claude setup-token` (sk-ant-oat01-...).
CLAUDE_CODE_OAUTH_TOKEN=
AGENT_MODEL=claude-opus-5-5
# Optional per-run limits.
# AGENT_MAX_TURNS=80
# AGENT_MAX_BUDGET_USD=10
# AGENT_TIMEOUT_S=1800

# Folder on this machine that contains fw-large-v3 (faster-whisper), mounted
# read-only into the worker so edits never download models. Create it once
# with: python scripts/fetch_models.py
WHISPER_MODELS_HOST_DIR=
IMAGE_MODEL=gpt-image-1
STYLE_EXTRACTION_ENABLED=true
QUALITY_MAX_REVIEW_CYCLES=2
QUALITY_LUFS_TARGET=-14

# docker-compose overrides DATABASE_URL/STORAGE_ROOT/PROJECTS_ROOT for its
# containers, and scripts/dev_api.py overrides them for local runs (memory
# DB, ./.local folders), so these values only matter for custom setups.
DATABASE_URL=postgresql+asyncpg://video:video@postgres:5432/video
STORAGE_ROOT=/work/storage
PROJECTS_ROOT=/work/projects

WEB_ORIGIN=http://localhost:3000
ACCESS_TOKEN_SECRET=replace-me-in-development-use-a-long-random-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
MAX_UPLOAD_BYTES=1073741824
API_URL=http://localhost:8000
